# FitLens 后端环境变量示例（复制为 .env 使用，切勿提交真实密钥）。
# 把本文件复制为 server/.env，然后填入真实值。

# 服务端口
PORT=4000

# DeepSeek 视觉 API（服务端读取，绝不出现在前端/仓库）
# 模型 deepseek-chat 支持图片输入，见 https://api-docs.deepseek.com/zh-cn/guides/vision/
DEEPSEEK_API_KEY=your_server_side_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 会话有效期（毫秒），默认 7 天
SESSION_TTL_MS=604800000

# CAPTCHA 提供方：builtin（内置图形验证码，仅本地开发/演示）| turnstile（Cloudflare Turnstile）
CAPTCHA_PROVIDER=builtin
# 使用 turnstile 时填入服务端密钥（不要放在前端）
TURNSTILE_SECRET_KEY=

# 允许跨域来源（逗号分隔；生产改为你的网站域名，例如 https://xxx.github.io）
ALLOWED_ORIGINS=*

# 数据目录（默认 server/data）
# DATA_DIR=
